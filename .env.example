# Copy this file to `.env` and fill in the real values (see class-endpoints.txt).
# Never commit the real `.env` — it is gitignored.

# Required: API key for the class services (all ports share one key).
LLM_API_KEY=your_api_key_here

# Optional overrides — defaults point at the class endpoints, so normally you
# only need LLM_API_KEY.
# BASE_URL_LLM=http://dobolyi.com:9001/v1
# BASE_URL_IMAGE=http://dobolyi.com:9006/v1
# BASE_URL_MUSIC=http://dobolyi.com:9007
# BASE_URL_TTS=http://dobolyi.com:9008
# MODEL_LLM=cyankiwi/Qwen3.6-35B-A3B-AWQ-4bit
# MODEL_IMAGE=black-forest-labs/FLUX.2-klein-4B
# MODEL_TTS=chatterbox-v3
